# Copy to .env at the repo root (never commit .env itself) and fill in a
# real token. Generate one with: openssl rand -hex 32
#
# Settings use the Q_CORE_ prefix.
Q_CORE_API_TOKEN=replace-with-a-long-random-value

# Optional overrides — defaults already resolve relative to the repo root:
# Q_CORE_DB_PATH=/absolute/path/to/data/q-core.db
# Q_CORE_DOCUMENTS_DIR=/absolute/path/to/data/documents
# Q_CORE_EVAL_SUMMARIES_DIR=/absolute/path/to/data/evals/published
# Q_CORE_FORECAST_DIR=/absolute/path/to/data/forecast
# Q_CORE_PORT=8420
# Q_CORE_TIMEZONE=UTC
# Required before extracting documents: create/review locally per
# runbooks/document-privacy.md. The file must be mode 0600 and outside intake/.
# Q_CORE_PRIVACY_PROFILE_PATH=/absolute/path/to/data/privacy/redaction.json

# Google Calendar OAuth client credentials may be supplied here, but macOS
# Keychain is preferred so the client secret is not plaintext in the project.
# See runbooks/google-calendar.md for the exact Keychain commands, callback URL
# and one-time connection flow.
# Q_CORE_GOOGLE_OAUTH_CLIENT_ID=...
# Q_CORE_GOOGLE_OAUTH_CLIENT_SECRET=...
